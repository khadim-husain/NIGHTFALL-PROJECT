# Project Nightfall - Backend Environment Variables Template (No Secrets)

# Server Configuration
PORT=8000
NODE_ENV=development
LOG_LEVEL=info

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME?schema=public

# CORS Configuration (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Authentication & Security
# Development / Demo JWT Secret for fallback token signing and verification (must be >= 32 chars)
JWT_SECRET=your-random-jwt-secret-key-at-least-32-chars-long
# Set to 'true' to permit local demo credentials (e.g. admin@nightfall.io) for testing without Firebase Admin credentials
ALLOW_DEMO_AUTH=true

# Firebase Authentication (Server-Side ID Token Verification)
# Required for production; if unconfigured, server logs explicit warning and relies on validated demo tokens if ALLOW_DEMO_AUTH=true
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Storage Configuration
# Options: 'local' (development sandbox) or 'supabase' (private object storage)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=nightfall-documents

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Print Simulator Configuration
SIMULATOR_TICK_INTERVAL_MS=2000
SIMULATOR_AUTO_START=true
